# --- Database -------------------------------------------------------------
# Production-style connection string. For a quick local spin-up with no
# server at all, tests use in-process PGlite instead (npm test).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chapterhouse_demo

# --- Stripe (TEST MODE ONLY — never put live keys here) -------------------
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
# `stripe listen --forward-to localhost:3000/webhooks/stripe` prints this
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Internal machine-to-machine routes -----------------------------------
# Sent as the x-cron-secret header by the nightly scheduler.
CRON_SECRET=change-me-to-a-long-random-string

# --- Ops -------------------------------------------------------------------
PORT=3000
ALERT_EMAIL=ops@brightside.example
